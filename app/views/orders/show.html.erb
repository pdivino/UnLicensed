<h1>Invoice #<%= @order.id %></h1>
<p>Placed on <%= @order.created_at.strftime("%B %-d, %Y") %> | Status: <%= @order.status %></p>

<h2>Customer</h2>
<p>
  <%= @order.customer.name %><br>
  <%= @order.customer.email %><br>
  <%= @order.customer.address %><br>
  <%= @order.customer.city %>, <%= @order.customer.province.name %>
  <%= @order.customer.postal_code %>
</p>

<h2>Items</h2>
<table class="cart-table">
  <thead>
    <tr>
      <th>Product</th>
      <th>Price</th>
      <th>Qty</th>
      <th>Subtotal</th>
    </tr>
  </thead>
  <tbody>
    <% @order.order_items.each do |item| %>
      <tr>
        <td><%= item.product.name %></td>
        <td><%= number_to_currency(item.unit_price) %></td>
        <td><%= item.quantity %></td>
        <td><%= number_to_currency(item.line_total) %></td>
      </tr>
    <% end %>
  </tbody>
  <tfoot>
    <tr>
      <td colspan="3">Subtotal</td>
      <td><%= number_to_currency(@order.subtotal) %></td>
    </tr>
    <% if @order.gst_amount > 0 %>
      <tr>
        <td colspan="3">GST (<%= number_to_percentage(@order.gst_rate * 100, precision: 2) %>)</td>
        <td><%= number_to_currency(@order.gst_amount) %></td>
      </tr>
    <% end %>
    <% if @order.pst_amount > 0 %>
      <tr>
        <td colspan="3">PST (<%= number_to_percentage(@order.pst_rate * 100, precision: 3) %>)</td>
        <td><%= number_to_currency(@order.pst_amount) %></td>
      </tr>
    <% end %>
    <% if @order.hst_amount > 0 %>
      <tr>
        <td colspan="3">HST (<%= number_to_percentage(@order.hst_rate * 100, precision: 2) %>)</td>
        <td><%= number_to_currency(@order.hst_amount) %></td>
      </tr>
    <% end %>
    <tr>
      <td colspan="3"><strong>Total</strong></td>
      <td><strong><%= number_to_currency(@order.total) %></strong></td>
    </tr>
  </tfoot>
</table>

<p><%= link_to "Continue shopping", root_path %></p>