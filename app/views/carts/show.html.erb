<%= link_to "← Keep shopping", root_path %>

<h1>Your cart</h1>

<% if @items.any? %>
  <table class="cart-table">
    <thead>
      <tr>
        <th>Product</th>
        <th>Price</th>
        <th>Quantity</th>
        <th>Subtotal</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @items.each do |item| %>
        <tr>
          <td><%= link_to item[:product].name, item[:product] %></td>
          <td><%= number_to_currency(item[:product].price) %></td>
          <td>
            <%= form_with url: update_cart_item_path(item[:product]), method: :patch do |form| %>
              <%= form.number_field :quantity, value: item[:quantity], min: 1, max: 99, style: "width: 4em;" %>
              <%= form.submit "Update" %>
            <% end %>
          </td>
          <td><%= number_to_currency(item[:product].price * item[:quantity]) %></td>
          <td><%= button_to "Remove", remove_cart_item_path(item[:product]), method: :delete %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <p class="cart-total">Total: <%= number_to_currency(@total) %></p>

  <p><%= link_to "Proceed to checkout", checkout_path, class: "add-button" %></p>
<% else %>
  <p>Your cart is empty.</p>
<% end %>