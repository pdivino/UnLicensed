<%# Partial: one product card. The underscore in the file name makes it a partial. %>
<%# It's reused for every product on the front page (rubric 4.1.4). %>
<div class="product-card">
  <% if product.image.attached? %>
    <%= link_to image_tag(product.image, alt: product.name), product %>
  <% end %>
  <h2><%= link_to product.name, product %></h2>
  <p class="category"><%= product.category.name %></p>
  <p class="price"><%= number_to_currency(product.price) %></p>
  <%# button_to makes a small form with a security token, posting to the cart (rubric 3.1.1). %>
  <%= button_to "Add to cart", add_to_cart_path(product), class: "add-button" %>
</div>