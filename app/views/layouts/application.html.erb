<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "UnLicensed" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%# Top menu with category links (partial: layouts/_header.html.erb). %>
    <%= render "layouts/header" %>

    <%# Flash message, e.g. "Canvas Work Shirt was added to your cart." (rubric 4.2.3). %>
    <% if notice %>
      <p class="flash-notice"><%= notice %></p>
    <% end %>

    <main>
      <%= yield %>
    </main>
  </body>
</html>